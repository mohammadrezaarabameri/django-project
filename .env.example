# Set to true for local development only.
DJANGO_DEBUG=false

# Replace with a long, unique secret in your local .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated hostnames accepted by Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated HTTPS origins trusted for CSRF-protected requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
